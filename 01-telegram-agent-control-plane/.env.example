# Copy to .env (or export in your shell). Never commit the real values.
TELEGRAM_BOT_TOKEN=123456:replace-with-your-botfather-token
TELEGRAM_CHAT_IDS=111111111,222222222
AGENT_PROJECT_DIR=/path/to/the/project/the/agent/should/work/in
AGENT_CMD=claude
AGENT_AUTO_APPROVE=0
AGENT_TURN_TIMEOUT=1800
# Optional multi-device onboarding: an unknown sender who texts this exact code gets added.
BRIDGE_CLAIM_CODE=
# Optional voice hooks. Each receives one extra argument (audio path / text to speak).
TRANSCRIBE_CMD=
SPEAK_CMD=
